{
    "name": "massachusetts-river-alliance",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint --max-warnings=0",
        "lint:fix": "eslint --fix",
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "next typegen && tsc --noEmit"
    },
    "dependencies": {
        "cn": "^0.4.0",
        "lucide-react": "^1.57.0",
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4",
        "typescript": "^5",
        "typescript-eslint": "^8.71.1"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs}": [
            "eslint --max-warnings=0 --no-warn-ignored",
            "prettier --write"
        ],
        "*.{json,css,md,yml,yaml}": "prettier --write"
    }
}
